# ============================================================
# PropSwipe v2 - environment variables
# Copy this file to  .env.local  and fill in the values.
# NEVER commit .env.local.  Restart `npm run dev` after any change.
# ============================================================

# ---------- Firebase WEB config (safe to be public by design) ----------
# Firebase console > Project settings > General > Your apps > Web app > Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ---------- Gemini (SERVER ONLY - never prefix with NEXT_PUBLIC_) ----------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model names change. Keep them here (not in code) so a shutdown = 1 line fix.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ---------- AI safety limits ----------
AI_RATE_LIMIT_PER_MIN=15
AI_TIMEOUT_MS=15000
